# Nimiq node JSON-RPC. Keep this bound to localhost — never expose it publicly.
NIMIQ_RPC_URL=http://127.0.0.1:8648

# MySQL, reachable over localhost. Give this app its own user and database with
# grants on `reef.*` only — if it shares a host with anything else, it must not
# be able to read or write that.
DB_HOST=127.0.0.1
DB_PORT=3306
DB_USER=reef
DB_PASSWORD=
DB_NAME=reef

# Signing key for session cookies. Generate with: openssl rand -hex 32
SESSION_SECRET=

# Shared secret for POST /api/tick. Only the systemd timer should know it.
TICK_SECRET=

# Public origin, used for share links and the sign-in challenge.
NEXT_PUBLIC_APP_ORIGIN=http://localhost:3000
# Production: https://reef.nimiq.cafe
