{
  "name": "nimiq-reef",
  "version": "0.1.0",
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "typecheck": "tsc --noEmit --incremental false",
    "migrate": "node scripts/migrate.mjs",
    "check:progression": "bash scripts/progression-check.sh",
    "check:tank": "node scripts/tank-smoke.mjs",
    "check:feed": "node scripts/feed-smoke.mjs",
    "check:stake": "node scripts/stake-smoke.mjs",
    "qr": "node scripts/make-qr.mjs",
    "icons": "bash -c 'rm -rf .icons && npx tsc --ignoreConfig src/lib/tank/*.ts --outDir .icons/tank --module esnext --target es2022 --moduleResolution bundler --skipLibCheck >/dev/null 2>&1 || true; find .icons -name \"*.js\" -print0 | xargs -0 sed -i \"\" -E \"s|from .(\\./[a-z]+).|from \\\"\\1.js\\\"|g\"; node scripts/make-icons.mjs'"
  },
  "author": "",
  "license": "ISC",
  "type": "module",
  "dependencies": {
    "@napi-rs/canvas": "^1.0.8",
    "@nimiq/core": "^2.20.0",
    "@nimiq/hub-api": "^1.14.0",
    "@nimiq/mini-app-sdk": "^0.1.0",
    "@nimiq/utils": "^0.12.4",
    "jose": "^6.2.10",
    "mysql2": "^3.24.0",
    "next": "^16.3.2",
    "react": "^19.2.8",
    "react-dom": "^19.2.8",
    "server-only": "^0.0.1"
  },
  "devDependencies": {
    "@types/node": "^26.2.0",
    "@types/react": "^19.2.18",
    "@types/react-dom": "^19.2.5",
    "jsqr": "^1.4.0",
    "qrcode": "^1.5.4",
    "typescript": "^7.0.2"
  }
}
