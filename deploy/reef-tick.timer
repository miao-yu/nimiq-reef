# /etc/systemd/system/reef-tick.timer
#
# Every 15 minutes — the same cadence the pool's payout job runs at, which is
# what makes "one watering" a real unit rather than an invented one.
[Unit]
Description=Water the reefs every 15 minutes

[Timer]
OnBootSec=2min
OnUnitActiveSec=15min
AccuracySec=30s
Persistent=true

[Install]
WantedBy=timers.target
