# /etc/systemd/system/grove.service
#
# Nimiq Grove. Shares a box with a live validator, so this unit is locked down:
# it runs as its own user, cannot escalate, and can only write inside /opt/grove.
[Unit]
Description=Nimiq Grove
After=network-online.target mysql.service
Wants=network-online.target

[Service]
Type=simple
User=grove
Group=grove
WorkingDirectory=/opt/grove/app

Environment=NODE_ENV=production
Environment=PORT=3200
# Bind to loopback only. nginx is the only thing that may reach it.
Environment=HOSTNAME=127.0.0.1
EnvironmentFile=/opt/grove/db.env
EnvironmentFile=/opt/grove/app.env

ExecStart=/usr/bin/node .next/standalone/server.js
Restart=on-failure
RestartSec=5

NoNewPrivileges=true
PrivateTmp=true
PrivateDevices=true
ProtectSystem=strict
ProtectHome=true
ProtectKernelTunables=true
ProtectKernelModules=true
ProtectControlGroups=true
RestrictAddressFamilies=AF_INET AF_INET6 AF_UNIX
RestrictSUIDSGID=true
LockPersonality=true
ReadWritePaths=/opt/grove

StandardOutput=journal
StandardError=journal
SyslogIdentifier=grove

[Install]
WantedBy=multi-user.target
