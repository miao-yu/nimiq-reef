# /etc/systemd/system/reef.service
#
# Nimiq Reef. Shares a box with a live validator, so this unit is locked down:
# it runs as its own user, cannot escalate, and can only write inside /opt/reef.
[Unit]
Description=Nimiq Reef
After=network-online.target mysql.service
Wants=network-online.target

[Service]
Type=simple
User=reef
Group=reef
WorkingDirectory=/opt/reef/app

Environment=NODE_ENV=production
Environment=PORT=3200
# Bind to loopback only. nginx is the only thing that may reach it.
Environment=HOSTNAME=127.0.0.1
EnvironmentFile=/opt/reef/db.env
EnvironmentFile=/opt/reef/app.env

ExecStart=/usr/bin/node .next/standalone/server.js
Restart=on-failure
RestartSec=5

NoNewPrivileges=true
PrivateTmp=true
PrivateDevices=true
ProtectSystem=strict
ProtectHome=true
ProtectKernelTunables=true
ProtectKernelModules=true
ProtectControlGroups=true
RestrictAddressFamilies=AF_INET AF_INET6 AF_UNIX
RestrictSUIDSGID=true
LockPersonality=true
ReadWritePaths=/opt/reef

StandardOutput=journal
StandardError=journal
SyslogIdentifier=reef

[Install]
WantedBy=multi-user.target
